programa
{
	
	funcao inicio()
	{
		inteiro primeira_ava , segunda_ava , media_calculada
		
		escreva (" Nota da avaliação 1: ")
		leia (primeira_ava)

		escreva (" Nota da avaliação 2: ")
		leia (segunda_ava)

		media_calculada = (primeira_ava + segunda_ava) / (2)

		se (media_calculada >= 6)
		{escreva (" Aprovado")}
		
		senao {
			escreva (" Não aprovado ")
			}
		

		
		
	}
}
