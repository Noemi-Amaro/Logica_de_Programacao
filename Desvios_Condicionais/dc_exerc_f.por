programa
{
	
	funcao inicio()
	{
		inteiro valor1, valor2

		escreva ("Digite o valor1: ")
		leia(valor1)
		
		escreva ("Digite o valor2: ")
		leia(valor2)

		
		se (valor1 > valor2){
			escreva (valor1)}

		senao se (valor2 > valor1){
			escreva(valor2)}

			//como considerar que não serão lidos valores iguais?
		
	}
}
