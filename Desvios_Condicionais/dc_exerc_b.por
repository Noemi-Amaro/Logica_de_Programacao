programa
{
	
	funcao inicio()
	{
		inteiro Y
		 
		escreva ("Digite o valor de Y: ")
		leia(Y)

		se (Y >= 0)
		{escreva  ("Positivo") }

		senao
		{escreva  ("Negativo") }
	}
}
