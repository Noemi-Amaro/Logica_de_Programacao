programa
{
	
	funcao inicio()
	{
		
		real celsius , fahrenheit

		escreva ("Digite a temperatura em fahrenheit: ")
		leia (fahrenheit)
		
          celsius= ((fahrenheit - 32) / 9) * 5 
          
          escreva (fahrenheit, "°F corresponde à ", celsius, "°C.")
          


