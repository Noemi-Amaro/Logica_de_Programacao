programa
{
	
	funcao inicio()
	{
		real f, c
		
		para ( c = 10.0; c <= 100.0; c = c + 10.0) 
		{
		
		f = (9.0 * c + 160.0) / 5.0
		escreva("Celsius: ", c, "°C  |  Fahrenheit: ", f, "°F\n")
		}

	}
}
