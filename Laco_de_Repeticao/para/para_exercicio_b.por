programa
{
	
	funcao inicio()
	{
		inteiro num=0 , soma = 0
		
		para (num = 1;num<=100; num++){
			soma = soma + num

		}
		escreva ("O valor total da soma dos cem primeiros números é = ", soma)
		
	}
}
