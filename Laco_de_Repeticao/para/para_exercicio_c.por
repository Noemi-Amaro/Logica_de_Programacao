programa
{
	
	funcao inicio()
	{
		inteiro num , soma=0

		para(num=2 ; num <= 500 ; num= num+2){
			soma= soma + num
		}
		escreva (" A somatória dos valores pares existentes na faixa de 1 a 500 é : " ,soma)
	}
}

