programa
{
	
	funcao inicio()
	{
		inteiro i, soma
		i=0
		soma = 0

		faca{
			i = i + 1
			se (i % 2 ==0){
				//i++
				soma = soma + i
			}
		}

			enquanto (i<=500)
			escreva (soma)
	}
}

