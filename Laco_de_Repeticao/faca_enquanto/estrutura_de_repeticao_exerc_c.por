programa
{
	funcao inicio()
	{
		inteiro num_decrescente
		num_decrescente = 10

		faca {
			escreva (num_decrescente, "\n")
			 num_decrescente --
		}
		enquanto (num_decrescente >= 1)
		
	}	
	
}
