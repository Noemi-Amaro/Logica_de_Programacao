programa
{
	
	funcao inicio()
	{
		inteiro n, quadrado
		n=15
		

		enquanto (n <= 200){
			quadrado = n*n 
			n++
			escreva ( n , "² =" , quadrado , "\n")
// o n*n também pode ser colocado no escreva
			
		}
	}
}

