programa
{
	
	funcao inicio()
	{
		real n1, n2 , resultado = 0
		 n2=0


		 escreva ("Digite o primeiro valor: ")
			leia(n1)
		enquanto (n2 <= 0){
			
			escreva ("Digite o segundo valor: ")
			leia(n2)
			
			resultado = n1/n2
				
		}
		escreva ("A divisão dos dois numeros é = ", resultado )
	}
}
