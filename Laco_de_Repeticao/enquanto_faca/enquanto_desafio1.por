programa
{
	
	funcao inicio()
	{
	// Desafio 1 : Tabuada do numero 8
	inteiro  contador
	
	contador=0
		enquanto (contador < 10)
		{ 
			contador++
			escreva (contador, " x 8 = ", contador*8 , "\n")
			
		}
	}
}

