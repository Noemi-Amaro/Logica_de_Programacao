programa
{
	
	funcao inicio()
	{
	real n1 , n2 //,soma
			
		faca{
			escreva("Digite o primeiro número: ")
			leia(n1)

			escreva("Digite o segundo número: ")
			leia(n2)

//soma = n1+n2
		}
		
		enquanto (n1+n2 <= 50)
		escreva (" Esta soma é: " , n1+n2)
 //escreva ("Esta soma é: ",soma)
 //ao inves de fazer n1+n2, colocar a var soma
		}
	}


