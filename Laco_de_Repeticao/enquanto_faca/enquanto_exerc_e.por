programa
{
	
	funcao inicio()
	{
		inteiro soma = 0, i = 1
        
        enquanto (i <= 500) { 
            se (i % 2 == 0) 
            { 
                soma = soma + i
            }
             i++ 
        }
        
        escreva("A soma dos números pares é: ", soma)
		} 
		
	}

