programa
{
	
	funcao inicio()
	{
	    //vetor de 5 posições
	    //usamos o tipo de dado, nome do vetor[posições]
	    //posições: 0,1,2,3,4]
	    
		cadeia nome [5]
		nome[0] = "Noemi"
		nome[1] = "Marley"
		nome[2] = "Khadja"
		nome[3] = "Matheus"
		nome[4] = "Michael"

//caso queira uma posição específica
		escreva (nome [2]) //Khadja
	}
}
