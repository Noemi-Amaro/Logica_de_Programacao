programa
{
	
	funcao inicio()
	{
		cadeia filmes [6]
		real notas [6]
		
		inteiro filme
		filmes [0] = "Matrix"
		filmes [1] = "Titanic"
		filmes [2] = "Vingadores"
		filmes [3] = "Coringa"
		filmes [4] = "Avatar"
		filmes [5] = "Duna"
		
          escreva ("Escolha um número correspondente ao filme: \n")
		escreva (" 0 : Matrix \n")
		escreva (" 1 : Titanic \n")
		escreva (" 2 : Vingadores \n")
		escreva (" 3 : Coringa \n")
		escreva (" 4 : Avatar \n")
		escreva (" 5 : Duna \n")
		leia (filme)
		
	}
}
